# ========== LiveKit Configuration ==========
# Get these from your LiveKit dashboard
LIVEKIT_URL=wss://your-livekit-server.com
LIVEKIT_API_KEY=your_api_key
LIVEKIT_API_SECRET=your_api_secret

# ========== LLM: Claude Haiku 4.5 ==========
# Get from https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-your-key-here

# ========== Voice I/O ==========
# TTS: ElevenLabs with Jarvis voice clone
# Get API key from https://elevenlabs.io/
# Create a voice clone of "Jarvis" and use its ID
ELEVEN_API_KEY=your_elevenlabs_api_key
ELEVEN_VOICE_ID=your_jarvis_voice_cloned_id
ELEVEN_MODEL=eleven_turbo_v2_5

# STT: Deepgram (optional, LiveKit inference handles this automatically)
# DEEPGRAM_API_KEY=your_deepgram_api_key

# ========== Browser Automation ==========
# Set to true for production
PLAYWRIGHT_HEADLESS=false

# Slow down browser actions for debugging (milliseconds, 0 = no slowdown)
PLAYWRIGHT_SLOW_MO=0

# ========== Wake Word Configuration ==========
# Wake word to activate the agent
WAKE_WORD=jarvis

# Seconds before auto-deactivate after wake word detected
WAKE_WORD_TIMEOUT=30

# ========== Application Settings ==========
# DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# development, production
ENVIRONMENT=development
